# This is automatically generated by the makefile
#
# <src>                                      <mnt_point>  <type>  <mnt_flags and options>                              <fs_mgr_flags>

# Firmware & Base Partitions
/dev/block/mmcblk0boot0                      /spl         emmc    defaults                                             slotselect
/dev/block/mmcblk0boot1                      /spl_bk      emmc    defaults                                             defaults
/dev/block/by-name/uboot                     /uboot       emmc    defaults                                             slotselect
/dev/block/by-name/sml                       /sml         emmc    defaults                                             slotselect
/dev/block/by-name/trustos                   /tos         emmc    defaults                                             slotselect
/dev/block/by-name/teecfg                    /teecfg      emmc    defaults                                             slotselect
/dev/block/by-name/vbmeta                    /vbmeta      emmc    defaults                                             slotselect
/dev/block/by-name/vbmeta_system             /vbmeta_system emmc  defaults                                             slotselect
/dev/block/by-name/vbmeta_vendor             /vbmeta_vendor emmc  defaults                                             slotselect
/dev/block/by-name/dtbo                      /dtbo        emmc    defaults                                             slotselect

# Modem & Networking
/dev/block/by-name/l_ldsp                    /ltedsp      emmc    defaults                                             slotselect
/dev/block/by-name/l_gdsp                    /ltegdsp     emmc    defaults                                             slotselect
/dev/block/by-name/l_agdsp                   /lteagdsp    emmc    defaults                                             slotselect
/dev/block/by-name/l_cdsp                    /ltecdsp     emmc    defaults                                             slotselect
/dev/block/by-name/l_modem                   /ltemodem    emmc    defaults                                             slotselect
/dev/block/by-name/l_fixnv1                  /ltefixnv1   emmc    defaults                                             defaults
/dev/block/by-name/l_fixnv2                  /ltefixnv2   emmc    defaults                                             defaults
/dev/block/by-name/l_deltanv                 /ltedeltanv  emmc    defaults                                             slotselect
/dev/block/by-name/wcnmodem                  /wcnmodem    emmc    defaults                                             slotselect
/dev/block/by-name/gnssmodem                 /gnssmodem   emmc    defaults                                             slotselect

# Core Android Partitions
/dev/block/by-name/misc                      /misc        emmc    defaults                                             defaults
/dev/block/by-name/boot                      /boot        emmc    defaults                                             slotselect
/dev/block/by-name/persist                   /persist     emmc    defaults                                             defaults
/dev/block/by-name/logo                      /logo        emmc    defaults                                             defaults

# Logical Dynamic Partitions (EROFS)
system                                       /system      erofs   ro                                                   wait,logical,first_stage_mount,slotselect
system_ext                                   /system_ext  erofs   ro                                                   wait,logical,first_stage_mount,slotselect
vendor                                       /vendor      erofs   ro                                                   wait,logical,first_stage_mount,slotselect
odm                                          /odm         erofs   ro                                                   wait,logical,first_stage_mount,slotselect
product                                      /product     erofs   ro                                                   wait,logical,first_stage_mount,slotselect
vendor_dlkm                                  /vendor_dlkm erofs   ro                                                   wait,logical,first_stage_mount,slotselect
system_dlkm                                  /system_dlkm erofs   ro                                                   wait,logical,first_stage_mount,slotselect

# Data & Metadata (Fix Decryption)
/dev/block/by-name/metadata                  /metadata    f2fs    nodev,noatime,nosuid                                 wait,formattable,first_stage_mount,check
/dev/block/by-name/userdata                  /data        f2fs    noatime,nosuid,nodev,discard,inlinecrypt,resuid=10010,resgid=1065  wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,formattable

# Cache & Vendor Prod
/dev/block/by-name/cache                     /cache       f2fs    noatime,nosuid,nodev,discard                         wait,check,formattable
/dev/block/by-name/prodnv                    /mnt/vendor  ext4    noatime,nosuid,nodev                                 wait,check

# Removable Storage (Sync with twrp.flags)
/dev/block/mmcblk1p1                         /external_sd vfat    defaults                                             defaults
