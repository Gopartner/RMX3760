# Flags File for Realme C53 (RMX3760 - UMS9230)
# Synchronized with Android 15 Virtual A/B Target: init_boot

# External Storage & USB-OTG
/external_sd       vfat      /dev/block/mmcblk1p1    /dev/block/mmcblk1    flags=display="MicroSD";storage;wipeingui;removable;fsflags="utf8"
/usb-otg           vfat      /dev/block/sda1         /dev/block/sda        flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"

# Boot & Kernel Partitions
/boot              emmc      /dev/block/by-name/boot                       flags=display="Boot Kernel";backup=1;flashimg=1;slotselect
/init_boot         emmc      /dev/block/by-name/init_boot                  flags=display="Init Boot (Recovery)";backup=1;flashimg=1;slotselect
/vendor_boot       emmc      /dev/block/by-name/vendor_boot                flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/dtbo              emmc      /dev/block/by-name/dtbo                       flags=display="DTBO";backup=1;flashimg=1;slotselect

# Dynamic Super Image Partition
/super             emmc      /dev/block/by-name/super        flags=display="Super Image";backup=1;flashimg=1

# AVB VBMeta Partitions
/vbmeta            emmc      /dev/block/by-name/vbmeta                     flags=display="VBMeta";backup=1;flashimg=1;slotselect
/vbmeta_system     emmc      /dev/block/by-name/vbmeta_system              flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/vbmeta_vendor     emmc      /dev/block/by-name/vbmeta_vendor              flags=display="VBMeta Vendor";backup=1;flashimg=1;slotselect
/vbmeta_product    emmc      /dev/block/by-name/vbmeta_product             flags=display="VBMeta Product";backup=1;flashimg=1;slotselect
/vbmeta_system_ext emmc      /dev/block/by-name/vbmeta_system_ext          flags=display="VBMeta System Ext";backup=1;flashimg=1;slotselect

# Persistent & Device Specific Data
/metadata          ext4      /dev/block/by-name/metadata                   flags=display="Metadata";backup=1
/persist           ext4      /dev/block/by-name/persist                    flags=display="Persist";backup=1
/prodnv            ext4      /dev/block/by-name/prodnv                     flags=display="ProdNV (NVRAM)";backup=1

